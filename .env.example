# Primary PostgreSQL connection (required for database features)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_NAME=Production

# Optional additional named connections
DATABASE_URL_2=
DATABASE_NAME_2=
DATABASE_URL_3=
DATABASE_NAME_3=
DATABASE_URL_4=
DATABASE_NAME_4=

# Required for the only dashboard account. Keep these values server-side.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Generate with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=
